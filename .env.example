# Copy this file to .env and edit the values

# Port the server runs on
PORT=3000

# Public base URL of your app (used to build the QR code link).
# When you deploy online, set this to your real domain, e.g. https://myapp.com
APP_BASE_URL=http://localhost:3000

# Session secret - change this to a long random string
SESSION_SECRET=change-this-to-a-long-random-secret-string

# Admin login credentials
# Default username/password is: admin / admin123
# IMPORTANT: run "npm run create-admin" to generate your OWN secure password hash,
# then paste the output here instead of using the default.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=bacbe54736f6b75b02a9a797b21c8dbc:5c8a9082b954db97b153f88d339d07b56d4ce569e51b0f28938971dcfe9a652a6ab432c7cef9dbba31f343661370c7b2bb41c46eac4ee6e5c0a8451ea2342bf7
